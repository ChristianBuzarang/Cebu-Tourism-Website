@inject FavoritesService Fav
@implements IDisposable

<article class="flex h-full flex-col overflow-hidden rounded-2xl border-2 border-sea bg-white text-sea">
    <div class="relative">
        @if (D.Image is not null)
        {
            <img src="@D.Image" alt="@D.Name in @D.Area" class="h-52 w-full object-cover" loading="lazy" />
        }
        else
        {
            <div class="flex h-52 items-end bg-linear-to-br from-lagoon to-sea p-4">
                <span class="font-display text-2xl font-extrabold text-white">@D.Name</span>
            </div>
        }
        <button class="absolute right-3 top-3 rounded-full bg-white p-2 text-hibiscus shadow transition-transform hover:scale-110"
                @onclick="() => Fav.Toggle(D.Name)"
                aria-pressed="@Fav.IsSaved(D.Name)"
                aria-label="@(Fav.IsSaved(D.Name) ? "Remove " + D.Name + " from saved places" : "Save " + D.Name)">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="@(Fav.IsSaved(D.Name) ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.5 3 5 6.5 5c2 0 3.5 1.1 5.5 3 2-1.9 3.5-3 5.5-3C21 5 22.8 8.5 21.5 11.8 19.5 16.4 12 21 12 21z" />
            </svg>
        </button>
    </div>

    <div class="flex flex-1 flex-col gap-3 p-5">
        <div class="flex items-center justify-between gap-2">
            <h3 class="text-xl">@D.Name</h3>
            <span class="shrink-0 rounded-full bg-sun px-3 py-0.5 text-sm font-bold">@D.Category</span>
        </div>
        <p class="text-sm font-bold text-lagoon">@D.Area</p>
        <p>@D.Summary</p>

        <div class="mt-auto pt-2">
            <button class="chip" @onclick="() => more = !more" aria-expanded="@more">
                @(more ? "Hide travel tips" : "Show travel tips")
            </button>
            @if (more)
            {
                <dl class="mt-3 rounded-xl bg-shell p-4 text-sm">
                    <dt class="font-bold">Best time</dt><dd class="mb-2">@D.BestTime</dd>
                    <dt class="font-bold">Tip</dt><dd>@D.Tip</dd>
                </dl>
            }
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Destination D { get; set; } = default!;
    private bool more;

    protected override void OnInitialized() => Fav.Changed += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Fav.Changed -= Refresh;
}