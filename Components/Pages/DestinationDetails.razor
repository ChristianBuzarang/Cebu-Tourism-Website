@page "/destinations"
@inject DestinationService Svc
<PageTitle>Destinations | Visit Cebu</PageTitle>

<section class="mx-auto max-w-6xl px-6 py-14">
    <h1 class="text-4xl md:text-6xl">Where to go in Cebu</h1>
    <p class="mt-4 max-w-xl text-lg">Filter by the kind of day you want.</p>

    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter destinations">
        @foreach (var c in Svc.Categories)
        {
            <button class="chip @(c == selected ? "chip-on" : "")" aria-pressed="@(c == selected)" @onclick="() => selected = c">@c</button>
        }
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var d in Svc.ByCategory(selected))
        {
            <DestinationCard D="d" />
        }
    </div>
</section>

@code { private string selected = "All"; }
