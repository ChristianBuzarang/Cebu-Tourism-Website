@page "/"
@inject DestinationService Svc
<PageTitle>Visit Cebu | Beaches, waterfalls and island adventures</PageTitle>

<section class="mx-auto grid max-w-6xl items-center gap-10 px-6 py-14 md:grid-cols-2 md:py-20">
    <div>
        <h1 class="text-5xl leading-[1.05] md:text-7xl">Swim with sardines, climb to a hilltop temple.</h1>
        <p class="mt-6 max-w-md text-lg">Cebu packs Spanish-era history, waterfalls and turquoise water into one island. Here is where to go and how to fit it into four days.</p>
        <div class="mt-8 flex flex-wrap gap-3">
            <a href="/itinerary" class="btn-sun">See the 4-day itinerary</a>
            <a href="/destinations" class="btn border-2 border-sea hover:bg-sea hover:text-white">Browse destinations</a>
        </div>
    </div>
    <img src="images/cebu-guide.png" alt="Cebu travel guide cover showing waterfalls, island hopping boats and the sardine run"
         class="mx-auto w-full max-w-md rotate-2 rounded-2xl border-4 border-white shadow-xl" />
</section>

<section class="bg-sea py-16 text-white">
    <div class="mx-auto max-w-6xl px-6">
        <h2 class="text-3xl md:text-4xl">Start with these three</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
            @foreach (var d in featured)
            {
                <DestinationCard D="d" @bind-ActiveDestination="activeDestination" />
            }
        </div>
    </div>
</section>

<section class="mx-auto grid max-w-6xl items-center gap-10 px-6 py-20 md:grid-cols-2">
    <img src="images/cebu-poster.png" alt="Cebu poster: waterfalls, white sand beaches and sea turtles" class="mx-auto w-full max-w-sm rounded-2xl border-4 border-white shadow-xl -rotate-2" />
    <div>
        <h2 class="text-3xl md:text-4xl">What Cebu does well</h2>
        <ul class="mt-6 space-y-4 text-lg">
            <li><strong>Ocean adventures.</strong> The Moalboal sardine run, sea turtles and island hopping.</li>
            <li><strong>Iconic views.</strong> Kawasan Falls and the Moalboal coast.</li>
            <li><strong>History.</strong> Magellan's Cross, the basilica and Fort San Pedro are a short walk apart.</li>
            <li><strong>Easy food and slow evenings.</strong> Fresh seafood and sunset beaches.</li>
        </ul>
        <a href="/plan" class="btn-sea mt-8">Plan my trip</a>
    </div>
</section>

@code {
    private List<Destination> featured = new();
    private string? activeDestination; // Tracks the currently open card on the home page

    protected override void OnInitialized() =>
        featured = Svc.All.Where(d => d.Name is "Magellan's Cross" or "Temple of Leah" or "Mactan Beaches").ToList();
}